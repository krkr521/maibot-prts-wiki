{
  "manifest_version": 2,
  "id": "local.prts-wiki",
  "version": "1.0.3",
  "name": "PRTS 明日方舟百科",
  "description": "在正常交谈中自主查证明日方舟干员、技能、模组、敌人、关卡、物品与公开招募；使用 PRTS Wiki 官方 API，提供模型直接调用的工具及 slash 指令。",
  "author": {
    "name": "krkr521 (MaiBot port); wxgl (upstream)",
    "url": "https://github.com/krkr521"
  },
  "license": "AGPL-3.0-only",
  "urls": {
    "repository": "https://github.com/krkr521/maibot-prts-wiki",
    "homepage": "https://github.com/krkr521/maibot-prts-wiki",
    "documentation": "https://github.com/krkr521/maibot-prts-wiki/blob/main/README.md",
    "issues": "https://github.com/krkr521/maibot-prts-wiki/issues"
  },
  "host_application": {
    "min_version": "1.3.18",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.19.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.28.0"
    },
    {
      "type": "python_package",
      "name": "beautifulsoup4",
      "version_spec": ">=4.12.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.forward"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "tool"
}
